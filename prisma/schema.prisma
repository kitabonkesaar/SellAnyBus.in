// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  BUYER
  SELLER
  INSPECTOR
  SALES_EXECUTIVE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SellerType {
  INDIVIDUAL_OWNER
  FLEET_OPERATOR
  DEALER
  TOURISM_COMPANY
  SCHOOL_INSTITUTION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BusCategory {
  AC_SLEEPER
  SEATER
  SCHOOL_BUS
  STAFF_BUS
  TOURIST_COACH
  MINI_BUS
}

enum FuelType {
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum AcType {
  AC
  NON_AC
}

enum VehicleStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTIONS_REQUESTED
  INSPECTION_PENDING
  INSPECTED
  VALUATION_REVIEWED
  AWAITING_SELLER_PRICE_APPROVAL
  APPROVED
  PUBLISHED
  SUSPENDED
  SOLD
  ARCHIVED
  REJECTED
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum DocumentType {
  RC
  OWNER_ID
  INSURANCE
  FITNESS
  PERMIT
  TAX
  NOC_HYPOTHECATION
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum ValuationStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  SOLD
  ARCHIVED
}

enum ListingVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  INSPECTION_REQUESTED
  NEGOTIATION
  BOOKING_AGREEMENT
  SOLD
  LOST
  DUPLICATE
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  INSPECTION_REQUESTED
  NEGOTIATION
  BOOKING_AGREEMENT
  SOLD
  LOST
}

enum LeadQualification {
  UNQUALIFIED
  QUALIFIED
  HIGH_PRIORITY
}

enum ActivityType {
  CALL
  MESSAGE
  NOTE
  FOLLOW_UP
  STAGE_CHANGE
}

enum AppointmentType {
  VIEWING
  INSPECTION
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PaymentStatus {
  NOT_STARTED
  PARTIAL
  RECEIVED_PENDING_CONFIRMATION
  CONFIRMED
}

enum TransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationChannel {
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ContentType {
  TESTIMONIAL
  FAQ
  BANNER
}

enum AuctionStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  CANCELLED
}

model User {
  id             String         @id @default(uuid())
  phone          String         @unique
  email          String?        @unique
  name           String
  role           Role           @default(VISITOR)
  status         UserStatus     @default(ACTIVE)
  passwordHash   String?
  consentAt      DateTime       @default(now())
  consentVersion String         @default("1.0")
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sellerProfile  SellerProfile?
  vehicles       Vehicle[]      @relation("SellerVehicles")
  assignedInspections Inspection[] @relation("InspectorInspections")
  assignedLeads  Lead[]         @relation("SalesLeads")
  leadActivities LeadActivity[] @relation("CreatedActivities")
  enquiries      Enquiry[]      @relation("BuyerEnquiries")
  favourites     Favourite[]
  savedAlerts    SavedSearchAlert[]
  notifications  Notification[]
  auditLogs      AuditLog[]     @relation("UserAuditLogs")

  @@index([role])
  @@index([status])
  @@index([phone])
  @@index([email])
}

model SellerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerType         SellerType         @default(INDIVIDUAL_OWNER)
  businessName       String?
  district           String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([district])
  @@index([verificationStatus])
}

model Vehicle {
  id                 String         @id @default(uuid())
  sellerId           String
  seller             User           @relation("SellerVehicles", fields: [sellerId], references: [id], onDelete: Cascade)
  category           BusCategory
  bodyType           String
  make               String
  model              String
  manufactureYear    Int
  registrationYear   Int
  registrationNumber String         @unique
  chassisNumberEnc   String?
  fuelType           FuelType       @default(DIESEL)
  transmission       Transmission   @default(MANUAL)
  odometerKm         Int
  seatingCapacity    Int
  sleeperConfig      String?
  acType             AcType         @default(AC)
  colour             String
  ownersCount        Int            @default(1)
  permitType         String?
  hypothecated       Boolean        @default(false)
  insuranceValidTill DateTime?
  state              String         @default("Odisha")
  district           String
  city               String
  conditionSummary   String
  disclosedDefects   String?
  serviceHistory     String?
  status             VehicleStatus  @default(DRAFT)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  media              VehicleMedia[]
  documents          VehicleDocument[]
  inspections        Inspection[]
  valuations         Valuation[]
  listing            Listing?
  appointments       Appointment[]

  @@index([category])
  @@index([status])
  @@index([district])
  @@index([make])
  @@index([model])
  @@index([manufactureYear])
  @@index([seatingCapacity])
  @@index([fuelType])
  @@index([acType])
  @@index([sellerId])
}

model VehicleMedia {
  id         String          @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       MediaType       @default(IMAGE)
  storageKey String
  position   Int             @default(0)
  isPrimary  Boolean         @default(false)
  visibility MediaVisibility @default(PUBLIC)
  width      Int?
  height     Int?
  createdAt  DateTime        @default(now())

  @@index([vehicleId])
  @@index([isPrimary])
}

model VehicleDocument {
  id                String         @id @default(uuid())
  vehicleId         String
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sellerId          String?
  docType           DocumentType
  privateStorageKey String
  status            DocumentStatus @default(PENDING)
  rejectionReason   String?
  expiresAt         DateTime?
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([vehicleId])
  @@index([docType])
  @@index([status])
}

model Inspection {
  id               String           @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspectorId      String?
  inspector        User?            @relation("InspectorInspections", fields: [inspectorId], references: [id])
  scheduledAt      DateTime?
  location         String?
  status           InspectionStatus @default(SCHEDULED)
  checklistResults Json?
  overallScore     Float?
  summary          String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedBy       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  photos           InspectionPhoto[]

  @@index([vehicleId])
  @@index([inspectorId])
  @@index([status])
}

model InspectionPhoto {
  id           String     @id @default(uuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  storageKey   String
  caption      String?
  createdAt    DateTime   @default(now())

  @@index([inspectionId])
}

model Valuation {
  id               String          @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  comparables      Json?
  factors          Json?
  rangeMin         Int
  rangeMax         Int
  recommendedPrice Int
  reviewedBy       String?
  approvalStatus   ValuationStatus @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([vehicleId])
  @@index([approvalStatus])
}

model Listing {
  id                  String            @id @default(uuid())
  vehicleId           String            @unique
  vehicle             Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  slug                String            @unique
  askingPrice         Int
  publicationStatus   PublicationStatus @default(DRAFT)
  visibility          ListingVisibility @default(PUBLIC)
  sellerApprovedAt    DateTime?
  sellerApprovedPrice Int?
  publishedAt         DateTime?
  featured            Boolean           @default(false)
  featuredUntil       DateTime?
  viewsCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  enquiries           Enquiry[]
  favourites          Favourite[]
  reports             ListingReport[]
  transactions        Transaction[]
  auctions            AuctionEvent[]

  @@index([publicationStatus])
  @@index([visibility])
  @@index([featured])
  @@index([askingPrice])
  @@index([publishedAt])
  @@index([slug])
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model SavedSearchAlert {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([phone])
}

model Enquiry {
  id          String        @id @default(uuid())
  listingId   String
  listing     Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyerUser   User?         @relation("BuyerEnquiries", fields: [buyerUserId], references: [id], onDelete: SetNull)
  name        String
  phone       String
  intendedUse String
  timeline    String
  message     String?
  consentAt   DateTime      @default(now())
  status      EnquiryStatus @default(NEW)
  sourceIpHmac String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead        Lead?

  @@index([listingId])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model Lead {
  id            String            @id @default(uuid())
  enquiryId     String            @unique
  enquiry       Enquiry           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?             @relation("SalesLeads", fields: [assigneeId], references: [id], onDelete: SetNull)
  stage         LeadStage         @default(NEW)
  qualification LeadQualification @default(UNQUALIFIED)
  followUpAt    DateTime?
  suspicious    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  activities    LeadActivity[]
  transactions  Transaction[]

  @@index([assigneeId])
  @@index([stage])
  @@index([qualification])
}

model LeadActivity {
  id        String       @id @default(uuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  content   String
  createdBy String
  creator   User         @relation("CreatedActivities", fields: [createdBy], references: [id])
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([createdBy])
}

model Appointment {
  id           String            @id @default(uuid())
  type         AppointmentType
  vehicleId    String
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  participants Json
  scheduledAt  DateTime
  status       AppointmentStatus @default(SCHEDULED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledAt])
}

model Transaction {
  id            String         @id @default(uuid())
  listingId     String
  listing       Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agreedPrice   Int
  feeType       String         @default("COMMISSION_PERCENT")
  feeAmount     Int            @default(0)
  paymentStatus PaymentStatus  @default(NOT_STARTED)
  evidenceKeys  Json?
  confirmedBy   String?
  confirmedAt   DateTime?
  docChecklist  Json?
  transferStatus TransferStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([listingId])
  @@index([leadId])
  @@index([paymentStatus])
}

model Notification {
  id          String              @id @default(uuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  channel     NotificationChannel @default(SMS)
  templateKey String
  payload     Json
  status      NotificationStatus  @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId])
  @@index([phone])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ListingReport {
  id              String       @id @default(uuid())
  listingId       String
  listing         Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason          String
  details         String?
  reporterContact String?
  status          ReportStatus @default(PENDING)
  createdAt       DateTime     @default(now())

  @@index([listingId])
  @@index([status])
}

model ContentItem {
  id        String      @id @default(uuid())
  type      ContentType
  title     String
  body      String
  order     Int         @default(0)
  active    Boolean     @default(true)
  meta      Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type])
  @@index([active])
}

model Location {
  id        String   @id @default(uuid())
  state     String   @default("Odisha")
  district  String
  city      String?
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([state, district])
  @@index([active])
}

// Phase 2 Tables (Feature Flag AUCTIONS_ENABLED = false)
model AuctionEvent {
  id           String        @id @default(uuid())
  listingId    String
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title        String
  startTime    DateTime
  endTime      DateTime
  reservePrice Int
  status       AuctionStatus @default(UPCOMING)
  createdAt    DateTime      @default(now())

  bids         Bid[]

  @@index([listingId])
  @@index([status])
}

model Bid {
  id        String       @id @default(uuid())
  auctionId String
  auction   AuctionEvent @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  amount    Int
  status    BidStatus    @default(ACTIVE)
  createdAt DateTime     @default(now())

  @@index([auctionId])
  @@index([bidderId])
}
