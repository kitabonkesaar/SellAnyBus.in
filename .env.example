# ==========================================
# SellAnyBus.in Environment Configuration
# ==========================================

NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://sellanybus:sellanybus_dev_secret@localhost:5432/sellanybus_db?schema=public"

# Auth Secrets
JWT_ACCESS_SECRET="dev_access_jwt_secret_key_sellanybus_min_32_chars_ok"
JWT_REFRESH_SECRET="dev_refresh_jwt_secret_key_sellanybus_min_32_chars_ok"
APP_ENCRYPTION_KEY="dev_32_byte_hex_key_for_encrypt_0123456789abcdef0123456789abcdef"

# OTP Provider: 'console' for local dev (fixed OTP 123456), 'msg91' for production
OTP_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Storage Provider: 'local' for dev, 's3' for production (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
PRIVATE_STORAGE_DIR="./storage/private_documents"

S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BUCKET="sellanybus-public-media"
S3_PRIVATE_BUCKET="sellanybus-private-docs"

# Notification Provider: 'console' | 'smtp' | 'resend'
NOTIFICATION_PROVIDER="console"

# Feature Flags
AUCTIONS_ENABLED="false"

# Initial Admin Credentials (for seed / dev access)
INITIAL_ADMIN_EMAIL="admin@sellanybus.in"
INITIAL_ADMIN_PASSWORD="Admin@SellAnyBus2026!"
INITIAL_ADMIN_PHONE="9876543210"
